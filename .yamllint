# Pragmatic rules: infra YAML has long comment lines and `on:` workflow keys.
# secrets/*.yaml are sops ciphertext: their base64 blob lines cannot be
# wrapped, so line-length does not apply there (the sops-header guard
# still proves encryption, and gitleaks still scans the plaintext-
# er, the file - for accidental raw secrets).
extends: default
ignore: |
  secrets/*.yaml
  secrets/*.yml
rules:
  line-length: {max: 120}
  truthy: disable
  document-start: disable
  comments-indentation: disable
